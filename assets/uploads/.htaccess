Options -Indexes -ExecCGI
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule php_module>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8
RemoveHandler .jpg .jpeg
RemoveType .php .phtml .phar .php3 .php4 .php5 .php7 .php8

<FilesMatch "^[a-f0-9]{32}(?:_thumb)?\.jpg$">
  SetHandler None
  Require all granted
</FilesMatch>
<FilesMatch "^(?![a-f0-9]{32}(?:_thumb)?\.jpg$)">
  Require all denied
</FilesMatch>
<FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|rb|sh|shtml|svg|html?)$">
  Require all denied
</FilesMatch>
